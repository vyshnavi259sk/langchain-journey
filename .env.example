# Copy this file to .env and fill in your own key.
# .env itself is gitignored -- never commit real credentials.

# Groq API key, used by day4.py, day6.py, day7.py, day8-1.py, day8-2.py,
# day6_retrieval_rag.py, day7_conversation_memory.py,
# day8_conversational_rag.py, day9_tool_calling.py, and day10_react_agent.py
# (all six of which also run fine without it, falling back to an
# offline/retrieval-only or deterministic demo).
# Optionally used by day2_lcel_runnables.py too.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_key_here
